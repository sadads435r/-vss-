# DGX Spark office assistant deployment settings.
# Copy this file to .env and never commit the resulting file.

CAMERA_DEVICE=/dev/video0
CAMERA_STREAM_NAME=office-main
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=10
CAMERA_BITRATE_KBPS=4000
CAMERA_INPUT_FORMAT=auto
VST_VIDEO_STORAGE_SIZE_MB=128

OFFICE_API_PORT=8090
OFFICE_HTTPS_PORT=8443
OFFICE_UID=1000
OFFICE_GID=1000

VSS_UI_PORT=7777
VSS_AGENT_PORT=8000
VSS_VST_PORT=30888
ELASTICSEARCH_PORT=9200

# Required by the NVIDIA deployment. Supply real values only in .env or the shell.
NGC_CLI_API_KEY=
HF_TOKEN=
